# Copy this file to .env in the same folder and fill in the values you need.
#
# .env is gitignored. Your agent reads THIS file for the key names and never
# reads .env itself — so paste keys in yourself, and never into a chat window.
#
# Only fill in what your chosen workflow needs. seo, social and outreach
# normally need none of these.

# --- video ------------------------------------------------------------------
# Free tier, no card: https://www.pexels.com/api/
PEXELS_API_KEY=

# Free tier: https://elevenlabs.io  (Profile → API key)
ELEVENLABS_API_KEY=

# Optional — generated hook clips, paid per clip: https://fal.ai
# Check your credit balance before generating a batch.
FAL_KEY=

# --- images (optional; only to EDIT an image you already have) --------------
# Crops, background swaps, aspect-ratio variants, image A/B arms. One is enough.
# Google AI Studio ("nano banana"), has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI GPT Image, prepaid credits: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- bluesky (optional; only if you post there) -----------------------------
# App password, NOT your account password:
# bsky.app → Settings → Privacy and Security → App Passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- posting (only needed for Upload Post or Buffer; manual needs nothing) --
# Free to 10 posts/month, then paid: https://www.upload-post.com/
UPLOADPOST_API_KEY=

# Only if you already use Buffer. Note it needs media at a public URL.
BUFFER_ACCESS_TOKEN=

# --- outreach at volume (optional, advanced) -------------------------------
# Only once you've graduated past mail drafts and own a sending domain.
# See engine-outreach/references/advanced.md first: https://resend.com
RESEND_API_KEY=

# --- seo (optional) --------------------------------------------------------
# Microsoft Clarity — FREE at any volume, and the only source that tells you
# what people did ON the page (scroll depth, dead/rage clicks, quick-backs).
# clarity.microsoft.com → your project → Settings → Data Export → generate token
CLARITY_API_KEY=

# --- seo (optional, advanced) ----------------------------------------------
# Only if you already pay for these. Do not buy one for this.
AHREFS_API_KEY=
SEMRUSH_API_KEY=

# --- analytics at volume (optional, paid) ----------------------------------
# Browser reading is free and works. Add this only when it stops scaling.
APIFY_API_TOKEN=
